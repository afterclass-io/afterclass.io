# When adding additional environment variables, the schema in "/src/env"
# should be updated accordingly.

#==============================================================================
# Database Connection - Local Development
#==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
# Local Postgres default is 5432; Supabase POOLed PgBouncer is 6543 — set
# POSTGRES_PORT=6543 when pointing at Supabase (DIRECT port below stays 5432).
POSTGRES_PORT=5432
POSTGRES_DIRECT_URL_PORT=5432
POSTGRES_DB=postgres

#==============================================================================
# Database Connection - STAGE
#==============================================================================
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=changeme
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DIRECT_URL_PORT=5432
# POSTGRES_DB=postgres

#==============================================================================
# Database Connection - PROD
#==============================================================================
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=changeme
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DIRECT_URL_PORT=5432
# POSTGRES_DB=postgres

#==============================================================================
# Prisma
#==============================================================================
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
# Pooled app connection (Supabase PgBouncer). Port :6543 + pgbouncer=true.
# Serverless functions MUST keep the pool tiny: connection_limit=1 (each
# function instance holds at most one pooled connection). NEVER run
# interactive $transaction on this URL — quota.ts/ratelimit.ts use txDb
# (DIRECT_URL) instead (see src/server/db.ts).
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?pgbouncer=true&connection_limit=1"
# Direct (non-pooled) connection. Port :5432, NO pgbouncer flag. Used for
# migrations (`prisma migrate deploy` runs on DIRECT_URL) and interactive
# $transactions. REQUIRED in production (src/server/db.ts throws at boot
# without it); optional locally (txDb falls back to the pooled client).
# Supabase dashboard: Settings -> Database -> Connection string -> "Direct
# connection" (:5432).
DIRECT_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_DIRECT_URL_PORT}/${POSTGRES_DB}"

#==============================================================================
# NextAuth / Auth.js
#==============================================================================
# You can generate a new secret on the command line with:
# openssl rand -base64 32
# https://authjs.dev/reference/core#secret
NEXTAUTH_SECRET="CvN2qK1adeaBxgcgTmnMNzGPO4SPrs2yuF1RVfQ/VY4=" # not used for production
NEXTAUTH_URL="http://localhost:3000"
# https://authjs.dev/getting-started/providers/google - Google OAuth
GOOGLE_CLIENT_ID="GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="GOOGLE_CLIENT_SECRET"

#==============================================================================
# Supabase - STAGE
#==============================================================================
# https://supabase.io/docs/reference/environment-variables
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_ID.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="SUPABASE_ANON_KEY"

#==============================================================================
# Application Settings
#==============================================================================
# School domains (comma-separated)
NEXT_PUBLIC_SUPPORTED_SCH_DOMAINS="smu.edu.sg,sch1.com,sch2.com"
# AC Channels' Link
NEXT_PUBLIC_AC_CHANNEL_LINK=https://t.me/xxxxxx1
NEXT_PUBLIC_AC_HELPDESK_LINK=https://t.me/xxxxxx2
NEXT_PUBLIC_AC_GITHUB_LINK=https://github.com/xxxxxx

#==============================================================================
# LLM Provider (OpenAI-compatible)
#==============================================================================
# LLM provider for the assistant (OpenAI-compatible). Defaults point at the
# current backend but any OpenAI-compatible endpoint works.
LLM_API_KEY=sk-placeholder-change-me
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# Optional: override chat limits (per minute, fixed window) and the LLM
# input-token budget. Defaults come from src/server/config/chat-config.ts; set
# these to change limits on redeploy without code changes.
# Full tunable list (canonical source: src/server/config/chat-config.ts):
# CHAT_QUOTA_PER_MONTH=50
# CHAT_NUDGE_AT=40
# CHAT_RATE_LIMIT_PER_MINUTE=10
# CHAT_MCP_RATE_LIMIT_PER_MINUTE=60
# CHAT_WRITE_RATE_LIMIT_PER_MINUTE=10
# CHAT_RATE_LIMIT_WINDOW_MINUTES=1
# CHAT_MAX_INPUT_TOKENS=64000
# CHAT_MAX_OUTPUT_TOKENS=4096
# CHAT_MAX_TOOL_ROUNDS=12
# CHAT_SPEND_CAP_USD=20
# CHAT_SPEND_CAP_PER_MONTH_USD=20
# CHAT_SETTLEMENT_SPIKE_TOKENS=30000
# CHAT_MAX_TOOL_RESULT_CHARS=24000
# CHAT_ICAL_THROTTLE_PER_MINUTE=60
# CHAT_IN_FLIGHT_STALE_MS=300000
# CHAT_RATE_LIMIT_RETENTION_WINDOWS=1440
# BID_MIN_AMOUNT=10
# BID_MAX_BUDGET=10000
# BID_DEFAULT_BEATS_PCT=70
# BID_MAX_AMOUNT=99999
# APP_TIMEZONE=Asia/Singapore
# CHAT_MAX_DURATION_SEC=300
# Set to 1 to log raw LLM usage payloads per turn (verify cache-hit field mapping)
CHAT_LOG_USAGE=

# Vercel Edge Config (live config layer for chat tunables; optional until
# wired — getChatConfig falls back to config.json + defaults without it).
EDGE_CONFIG="https://edge-config.vercel.com/EDGE_CONFIG_ID?token=EDGE_CONFIG_TOKEN"

# Vercel Cron guard for GET /api/cron/prune-rate-limits (RateLimit GC).
# Generate with `openssl rand -base64 32`; Vercel sends it as
# `Authorization: Bearer <CRON_SECRET>` on cron invocations. REQUIRED on
# Vercel once vercel.json crons are live — the handler 500s without it
# rather than running unguarded.
CRON_SECRET="change-me-openssl-rand-base64-32"

#==============================================================================
# MCP Use (mcp-use) - Supabase OAuth
#==============================================================================
# Values are passed explicitly in src/mcp/server.ts via
# oauthSupabaseProvider({ projectId, supabaseUrl, jwtSecret }) — the provider
# does not auto-read env vars. Set real values from the Supabase dashboard
# (Authentication -> OAuth Server). See src/mcp/README.md for full setup.
MCP_USE_OAUTH_SUPABASE_PROJECT_ID=PLACEHOLDER_SUPABASE_PROJECT_REF
# Optional: full Supabase auth URL, only for local / self-hosted Supabase
# (e.g. http://localhost:54321). Overrides the URL derived from PROJECT_ID.
# Passed explicitly as supabaseUrl in src/mcp/server.ts when set.
# MCP_USE_OAUTH_SUPABASE_URL=
# Optional: only for legacy HS256 Supabase JWT projects (omit for the default RS256).
# Passed explicitly as jwtSecret in src/mcp/server.ts when set.
# MCP_USE_OAUTH_SUPABASE_JWT_SECRET=
# NOTE: MCP_USE_OAUTH_SUPABASE_PUBLISHABLE_KEY is NOT a server env var - it is a
# client-facing Dynamic Client Registration (DCR) credential obtained by MCP clients.
# Local MCP Inspector dev bypass (no Supabase needed): `bun run mcp:dev` sets
# these automatically via scripts/mcp-dev.ts. Only set explicitly to override:
# MCP_DEV_BYPASS=false tests the fail-closed path; MCP_DEV_USER_EMAIL=...
# tests a different dev user (must exist in the local seeded DB).
# MCP_DEV_BYPASS=true
# MCP_DEV_USER_EMAIL=test_hash_pwd@smu.edu.sg
# Production transport hardening (DNS-rebinding protection, additive to the
# localhost-class defaults — unset for local dev). Comma-separated:
# MCP_ALLOWED_HOSTS=<mcp-hostname> (e.g. <slug>.run.mcp-use.com)
# MCP_ALLOWED_ORIGINS=<browser-client-host> (non-GET/HEAD Origin check)
# MCP_ALLOWED_HOSTS=
# MCP_ALLOWED_ORIGINS=
# Proxy override: behind a proxy/tunnel the server derives its public origin
# from MCP_URL (origin only — a path suffix is ignored); set MCP_ASSETS_URL
# only when view JS/CSS are served from a CDN. Local dev needs neither.
# MCP_URL=https://<slug>.run.mcp-use.com
# MCP_ASSETS_URL=
# Optional: public MCP URL for Settings -> Agents deep links (falls back to placeholder until deployed)
# NEXT_PUBLIC_MCP_PUBLIC_URL=https://<slug>.run.mcp-use.com/mcp
