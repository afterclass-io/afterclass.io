{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // CI runs two passes on Linux (.github/workflows/knip.yml):
  //   1. `bunx knip --production --exclude files,exports,types` checks
  //      dependencies against production code only.
  //   2. `bunx knip` checks files, exports and types. Tests, stories and tool
  //      config count as users, so only code that nothing reaches is reported.
  "ignoreDependencies": [
    "@prisma/client",
    "@tailwindcss/oxide-win32-x64-msvc",
    // Imported only by next.config.js and prisma.config.ts. The `--production`
    // pass does not trace root tool config and reports both unused. The default
    // pass sees them and prints a "Remove from ignoreDependencies" hint, which
    // does not fail the run (checked on Linux with knip 6.41.0).
    "dotenv",
    "jiti",
    "pg",
    // Run by git hooks (`prepare` script, lefthook.yml), not imported.
    "lefthook",
  ],
  "ignoreIssues": {
    // Run by hand: `bun run scripts/perf/<name>.ts` (docs/perf/README.md).
    "scripts/perf/*.ts": ["files"],
    // Aliased in vitest.config.ts, which knip cannot follow.
    "vitest.server-only.stub.ts": ["files"],

    // MCP entry: mcp-use loads this module and mcp-env.d.ts types the
    // exported tool refs.
    "src/mcp/index.ts": ["exports"],

    // Storybook mocks copy the shape of the library they replace.
    ".storybook/mocks/*.ts": ["exports", "types"],

    // shadcn/ui convention: each component file keeps every part the upstream
    // kit exports, so a screen can compose a part without editing the kit.
    "src/common/components/{alert-dialog,breadcrumb,card,chart,dialog,dropdown-menu,form,popover,select,sheet,sidebar,toggle}.tsx": [
      "exports",
    ],

    // chat.test.ts loads it with a dynamic import, which knip cannot follow.
    // Removal waits for the owner (spec 23.3).
    "src/server/ecfg/chat.ts": ["exports"],

    // Kept on purpose: `resendEmail` still takes the email-change type.
    "src/server/supabase.ts": ["enumMembers"],
  },
  "rules": {
    "files": "error",
    "exports": "error",
    "types": "error",
  },
}
