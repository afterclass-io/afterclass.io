generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Reviews {
  id                   String   @id @default(uuid())
  body                 String
  tips                 String?
  rating               Int
  // == START ==
  // DO NOT update these fields manually
  // The following fields are updated automatically by triggers
  countEventViews      Int      @default(0) @map("count_event_views")
  countVotes           Int      @default(0) @map("count_votes")
  // === END ===
  reviewedProfessorId  String?  @map("reviewed_professor_id")
  reviewedCourseId     String   @map("reviewed_course_id")
  reviewedUniversityId Int      @map("reviewed_university_id")
  reviewedFacultyId    Int      @map("reviewed_faculty_id")
  reviewerId           String   @map("reviewer_id")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  reviewedCourse     Courses           @relation(fields: [reviewedCourseId], references: [id])
  reviewedFaculty    Faculties         @relation(fields: [reviewedFacultyId], references: [id])
  reviewedProfessor  Professors?       @relation(fields: [reviewedProfessorId], references: [id])
  reviewedUniversity Universities      @relation(fields: [reviewedUniversityId], references: [id])
  reviewer           Users             @relation(fields: [reviewerId], references: [id])
  reviewLabels       ReviewLabels[]
  votes              ReviewVotes[]
  reviewEvents       ReviewEvents[]
  reviewReactions    ReviewReactions[]
  moderationReports  ModerationReport[]

  @@index([createdAt], type: BTree)
  @@index([reviewedCourseId], type: BTree)
  @@index([reviewedProfessorId], type: BTree)
  @@index([reviewedCourseId, createdAt(sort: Desc)])
  @@index([reviewedProfessorId, createdAt(sort: Desc)])
  @@map("reviews")
}

model Users {
  id                       String   @id @default(uuid())
  email                    String   @unique
  username                 String   @unique
  isVerified               Boolean  @default(false) @map("is_verified")
  aiConsent                DateTime? @map("ai_consent")
  universityId             Int      @map("university_id")
  deprecatedPasswordDigest String?  @map("deprecated_password_digest")
  firstName                String?  @map("first_name")
  lastName                 String?  @map("last_name")
  telegramId               String?  @unique @map("telegram_id")
  photoUrl                 String?  @map("photo_url")
  facultyId                Int?     @map("faculty_id")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  faculty            Faculties?           @relation(fields: [facultyId], references: [id])
  university         Universities         @relation(fields: [universityId], references: [id])
  votes              ReviewVotes[]
  reviews            Reviews[]
  reviewEvents       ReviewEvents[]
  reviewReactions    ReviewReactions[]
  hackSubmissionVote HackSubmissionVote[]
  userBid            UserBid[]
  moderationReports  ModerationReport[]
  userTimetable      UserTimetable[]
  userRoadmap        UserRoadmap[]
  userBidBudget      UserBidBudget[]
  roadmapVotes       RoadmapVote[]
  roadmapReactions   RoadmapReaction[]
  chatUsage          ChatUsage[]
  createdMeetingPolls   MeetingPoll[]        @relation("MeetingPollCreator")
  meetingParticipations MeetingParticipant[]

  @@map("users")
}

model Universities {
  id         Int                    @id @default(autoincrement())
  name       String
  abbrv      UniversityAbbreviation @unique
  siteUrl    String                 @unique @map("site_url")
  createdAt  DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  courses    Courses[]
  faculties  Faculties[]
  professors Professors[]
  reviews    Reviews[]
  domains    UniversityDomains[]
  users      Users[]

  @@map("universities")
}

model UniversityDomains {
  id                   Int      @id @default(autoincrement())
  domain               String   @unique
  belongToUniversityId Int      @map("belong_to_university")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  belongToUniversity Universities @relation(fields: [belongToUniversityId], references: [id])

  @@map("university_domains")
}

model Courses {
  id                    String   @id @default(uuid())
  code                  String   @unique
  name                  String
  description           String
  creditUnits           Float    @map("credit_units")
  belongToUniversityId  Int      @map("belong_to_university")
  belongToFacultyId     Int      @map("belong_to_faculty")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  courseArea            String?  @map("course_area")
  enrolmentRequirements String?  @map("enrolment_requirements")

  belongToFaculty    Faculties    @relation(fields: [belongToFacultyId], references: [id])
  belongToUniversity Universities @relation(fields: [belongToUniversityId], references: [id])
  classes            Classes[]
  reviews            Reviews[]
  userRoadmapEntry   UserRoadmapEntry[]
  meetingPolls       MeetingPoll[]

  @@map("courses")
}

model Professors {
  id                   String   @id @default(uuid())
  name                 String
  bossAliases          String[] @default([]) @map("boss_aliases")
  email                String
  slug                 String   @unique
  photoUrl             String   @map("photo_url")
  profileUrl           String   @map("profile_url")
  belongToUniversityId Int      @map("belong_to_university")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  belongToUniversity Universities         @relation(fields: [belongToUniversityId], references: [id])
  belongToFaculties  ProfessorFaculties[]
  classes            Classes[]
  reviews            Reviews[]

  @@map("professors")
}

model ProfessorFaculties {
  id          Int      @id @default(autoincrement())
  professorId String   @map("professor_id")
  facultyId   Int      @map("faculty_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  faculty   Faculties  @relation(fields: [facultyId], references: [id])
  professor Professors @relation(fields: [professorId], references: [id])

  @@map("professor_faculties")
}

model Faculties {
  id                   Int      @id @default(autoincrement())
  name                 String
  acronym              String
  siteUrl              String   @map("site_url")
  belongToUniversityId Int      @map("belong_to_university")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  belongToUniversity Universities @relation(fields: [belongToUniversityId], references: [id])

  belongToFaculties ProfessorFaculties[]
  courses           Courses[]
  reviews           Reviews[]
  users             Users[]

  @@unique([belongToUniversityId, acronym])
  @@map("faculties")
}

model Classes {
  id               String        @id @default(uuid())
  section          String
  courseId         String        @map("course_id")
  professorId      String?       @map("professor_id")
  acadTermId       String        @map("acad_term_id")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  gradingBasis     GradingBasis? @map("grading_basis")
  courseOutlineUrl String?       @map("course_outline_url")
  bossId           Int           @map("boss_id")
  warnInaccuracy   Boolean       @default(false) @map("warn_inaccuracy")

  classTimings      ClassTiming[]
  classExamTimings  ClassExamTiming[]
  classAvailability ClassAvailability[]
  bidResult         BidResult[]
  bidPrediction     BidPrediction[]

  course    Courses     @relation(fields: [courseId], references: [id])
  professor Professors? @relation(fields: [professorId], references: [id])
  acadTerm  AcadTerm    @relation(fields: [acadTermId], references: [id])
  userBid   UserBid[]

  userTimetableSlot UserTimetableSlot[]

  @@unique([bossId, acadTermId, professorId])
  @@unique([courseId, section, acadTermId, professorId])
  @@index([courseId], type: BTree)
  @@index([professorId], type: BTree)
  @@index([acadTermId, courseId])
  @@index([acadTermId, professorId])
  @@map("classes")
}

model ReviewVotes {
  reviewId  String   @map("review_id")
  voterId   String   @map("voter_id")
  weight    Int      @default(1) @db.SmallInt // 1 for UPVOTE, -1 for DOWNVOTE
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  review Reviews @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  voter  Users   @relation(fields: [voterId], references: [id])

  @@id([reviewId, voterId])
  @@index([reviewId, voterId], type: BTree)
  @@map("review_votes")
}

model Labels {
  id        Int             @id @default(autoincrement())
  name      ReviewLabelName
  typeOf    ReviewType      @map("type_of")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  reviewLabels ReviewLabels[]

  @@map("labels")
}

model ReviewLabels {
  id        Int      @id @default(autoincrement())
  labelId   Int      @map("label_id")
  reviewId  String   @map("review_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  label  Labels  @relation(fields: [labelId], references: [id])
  review Reviews @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId], type: BTree)
  @@index([reviewId, labelId])
  @@map("review_labels")
}

model ReviewEvents {
  id               String          @id() @db.Uuid
  reviewId         String          @map("review_id")
  eventType        ReviewEventType @map("event_type")
  triggeringUserId String?         @map("triggering_user_id")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  review         Reviews @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  triggeringUser Users?  @relation(fields: [triggeringUserId], references: [id])

  @@index([reviewId, eventType])
  @@map("review_events")
}

model ReviewReactions {
  reviewId       String             @map("review_id")
  reactingUserId String             @map("reacting_user_id")
  reaction       ReviewReactionType
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  review       Reviews @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reactingUser Users   @relation(fields: [reactingUserId], references: [id])

  @@id([reviewId, reactingUserId])
  @@index([reviewId, reactingUserId], type: BTree)
  @@map("review_reactions")
}

model AcadTerm {
  id            String   @id
  acadYearStart Int      @map("acad_year_start")
  acadYearEnd   Int      @map("acad_year_end")
  term          String   @map("term") @db.VarChar(2)
  bossId        Int      @map("boss_id")
  startDt       DateTime @map("start_dt") @db.Timestamptz(3)
  endDt         DateTime @map("end_dt") @db.Timestamptz(3)

  classes      Classes[]
  bidWindow    BidWindow[]
  safetyFactor SafetyFactor[]

  userTimetable UserTimetable[]
  userBidBudget UserBidBudget[]
  matricRoadmaps UserRoadmap[]
  meetingPolls   MeetingPoll[]

  @@map("acad_term")
}

model ClassTiming {
  id        Int      @id @default(autoincrement())
  classId   String   @map("class_id")
  startDate DateTime @map("start_date") @db.Timestamptz(3)
  endDate   DateTime @map("end_date") @db.Timestamptz(3)
  dayOfWeek String?  @map("day_of_week")
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  venue     String?  @map("venue")

  class Classes @relation(fields: [classId], references: [id])

  @@index([classId], type: BTree)
  @@map("class_timing")
}

model ClassExamTiming {
  id        Int      @id @default(autoincrement())
  classId   String   @map("class_id")
  date      DateTime @map("date") @db.Timestamptz(3)
  dayOfWeek String?  @map("day_of_week")
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  venue     String?  @map("venue")

  class Classes @relation(fields: [classId], references: [id])

  @@index([classId])
  @@map("class_exam_timing")
}

model ClassAvailability {
  // One class will have only one class availability per bid window
  classId         String @map("class_id")
  bidWindowId     Int    @map("bid_window_id")
  total           Int    @map("total")
  currentEnrolled Int    @map("current_enrolled")
  reserved        Int    @map("reserved")
  available       Int    @map("available")

  class     Classes   @relation(fields: [classId], references: [id])
  bidWindow BidWindow @relation(fields: [bidWindowId], references: [id])

  // Composite key from `classes` and `BidWindow`
  @@id([classId, bidWindowId])
  @@map("class_availability")
}

model BidWindow {
  // Each unique bid window is determined by acadTerm, round, and window
  id         Int       @id @default(autoincrement())
  acadTermId String    @map("acad_term_id")
  round      String    @map("round") @db.VarChar(2)
  window     Int       @map("window")
  opensAt    DateTime? @map("opens_at") @db.Timestamptz(3)   // Window opens (bidding starts) in SGT
  closesAt   DateTime? @map("closes_at") @db.Timestamptz(3)  // Window closes (bidding ends) in SGT
  resultsAt  DateTime? @map("results_at") @db.Timestamptz(3) // Results release datetime in SGT

  classAvailability ClassAvailability[]
  bidResult         BidResult[]
  bidPrediction     BidPrediction[]

  acadTerm AcadTerm  @relation(fields: [acadTermId], references: [id])
  userBid  UserBid[]

  @@index([acadTermId])
  @@map("bid_window")
}

model BidResult {
  bidWindowId          Int    @map("bid_window_id")
  classId              String @map("class_id")
  vacancy              Int
  openingVacancy       Int?   @map("opening_vacancy")
  beforeProcessVacancy Int    @map("before_process_vacancy")
  dice                 Int?   @map("d_i_c_e")
  afterProcessVacancy  Int?   @map("after_process_vacancy")
  enrolledStudents     Int    @map("enrolled_students")
  median               Float?
  min                  Float?

  bidWindow BidWindow @relation(fields: [bidWindowId], references: [id])
  class     Classes   @relation(fields: [classId], references: [id])

  @@id([bidWindowId, classId])
  @@index([classId])
  @@map("bid_result")
}

model HackSubmission {
  id                 String               @id @default(uuid())
  teamName           String               @map("team_name")
  submissionUrl      String               @map("submission_url")
  slideEmbedUrl      String               @map("slide_embed_url")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  hackSubmissionVote HackSubmissionVote[]

  @@map("hack_submission")
}

model HackSubmissionVote {
  hackSubmissionId String   @map("hack_submission_id")
  voterId          String   @map("voter_id")
  weight           Int      @default(1) @db.SmallInt // 1 for UPVOTE, -1 for DOWNVOTE
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  hackSubmission HackSubmission @relation(fields: [hackSubmissionId], references: [id])
  voter          Users          @relation(fields: [voterId], references: [id])

  @@id([hackSubmissionId, voterId])
  @@map("hack_submission_vote")
}

model BidPrediction {
  classId      String @map("class_id")
  bidWindowId  Int    @map("bid_window_id")
  modelVersion String @map("model_version")

  // Classification Results
  clfHasBidsProbability Float @map("clf_has_bids_prob")
  clfConfidenceScore    Float @map("clf_confidence_score")

  // Median/Min Regression Results
  medianPredicted   Float @map("median_predicted")
  medianUncertainty Float @map("median_uncertainty")

  minPredicted   Float @map("min_predicted")
  minUncertainty Float @map("min_uncertainty")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  class     Classes   @relation(fields: [classId], references: [id])
  bidWindow BidWindow @relation(fields: [bidWindowId], references: [id])

  @@id([classId, bidWindowId])
  @@index([modelVersion])
  @@map("bid_prediction")
}

model SafetyFactor {
  acadTermId      String         @map("acad_term_id")
  predictionType  PredictionType @map("prediction_type")
  beatsPercentage Int            @map("beats_percentage") // 1-99 (confidence level)
  multiplierType  MultiplierType @map("multiplier_type")
  multiplier      Float
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  acadTerm AcadTerm @relation(fields: [acadTermId], references: [id])

  @@id([acadTermId, predictionType, beatsPercentage, multiplierType])
  @@map("safety_factor")
}

model UserBid {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  classId     String   @map("class_id")
  bidWindowId Int      @map("bid_window_id")
  bidAmount   Float    @map("bid_amount")
  notes       String?
  status      UserBidStatus @default(PLANNED)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user          Users          @relation(fields: [userId], references: [id])
  class         Classes        @relation(fields: [classId], references: [id])
  bidWindow     BidWindow      @relation(fields: [bidWindowId], references: [id])

  @@index([userId, createdAt])
  @@index([classId, bidWindowId])
  @@unique([userId, classId, bidWindowId])
  @@map("user_bid")
}

model UserTimetable {
  id         String     @id @default(uuid())
  userId     String     @map("user_id")
  acadTermId String     @map("acad_term_id")
  name       String
  isActive   Boolean    @default(false) @map("is_active")
  visibility Visibility @default(PRIVATE)
  shareToken String?    @unique @map("share_token")
  icalToken  String?    @unique @map("ical_token")
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     Users               @relation(fields: [userId], references: [id])
  acadTerm AcadTerm            @relation(fields: [acadTermId], references: [id])
  slots    UserTimetableSlot[]

  @@index([userId, acadTermId])
  @@map("user_timetable")
}

model UserTimetableSlot {
  id          String @id @default(uuid())
  timetableId String @map("timetable_id")
  classId     String @map("class_id")

  timetable UserTimetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  class     Classes       @relation(fields: [classId], references: [id])

  @@unique([timetableId, classId])
  @@index([timetableId])
  @@index([classId])
  @@map("user_timetable_slot")
}

model UserRoadmap {
  id           String     @id @default(uuid())
  userId       String     @map("user_id")
  name         String
  description  String?
  visibility   Visibility @default(PRIVATE)
  shareToken   String?    @unique @map("share_token")
  slug         String?    @unique
  facultyId    Int?       @map("faculty_id") // snapshot from owner at publish time
  publishedAt  DateTime?  @map("published_at") @db.Timestamptz(3)
  isActive     Boolean    @default(false) @map("is_active") // at most one active roadmap per user
  matricTermId String?    @map("matric_term_id") // acad term corresponding to the user's Y1T1
  viewCount    Int        @default(0) @map("view_count")
  shareCount   Int        @default(0) @map("share_count")
  upvoteCount  Int        @default(0) @map("upvote_count")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        Users              @relation(fields: [userId], references: [id])
  matricTerm  AcadTerm?          @relation(fields: [matricTermId], references: [id])
  entries     UserRoadmapEntry[]
  votes       RoadmapVote[]
  reactions   RoadmapReaction[]
  moderationReports ModerationReport[]

  @@index([userId])
  @@index([visibility, publishedAt])
  @@map("user_roadmap")
}

model RoadmapVote {
  id        String   @id @default(uuid())
  roadmapId String   @map("roadmap_id")
  userId    String   @map("user_id")
  weight    Int      @default(1) @db.SmallInt // 1 for UPVOTE, -1 for DOWNVOTE (existing rows were likes = upvotes)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roadmap UserRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  user    Users       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roadmapId, userId])
  @@map("roadmap_vote")
}

model RoadmapReaction {
  roadmapId String             @map("roadmap_id")
  userId    String             @map("user_id")
  reaction  ReviewReactionType
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  roadmap UserRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  user    Users       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roadmapId, userId])
  @@map("roadmap_reaction")
}

model UserRoadmapEntry {
  id         String @id @default(uuid())
  roadmapId  String @map("roadmap_id")
  courseId   String @map("course_id")
  yearNumber Int    @map("year_number")
  term       String @db.VarChar(3) // T1 | T2 | T3A | T3B
  sortOrder  Int    @map("sort_order")

  roadmap UserRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  course  Courses     @relation(fields: [courseId], references: [id])

  @@index([roadmapId])
  @@index([courseId])
  @@map("user_roadmap_entry")
}

model UserBidBudget {
  userId     String @map("user_id")
  acadTermId String @map("acad_term_id")
  balance    Float

  user     Users    @relation(fields: [userId], references: [id])
  acadTerm AcadTerm @relation(fields: [acadTermId], references: [id])

  @@id([userId, acadTermId])
  @@map("user_bid_budget")
}

enum Visibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum UserBidStatus {
  PLANNED
  SECURED
  DROPPED
  CANCELLED
  PARTICIPATED
}

enum UniversityAbbreviation {
  SMU
  NUS
  NTU
}

enum ReviewLabelName {
  INTERESTING        @map("interesting")
  PRACTICAL          @map("practical")
  GAINED_NEW_SKILLS  @map("gained new skills")
  ENGAGING           @map("engaging")
  FAIR_GRADING       @map("fair grading")
  EFFECTIVE_TEACHING @map("effective teaching")
}

enum ReviewType {
  COURSE
  PROFESSOR
}

enum ReviewEventType {
  VIEW
  SHARE
  REACTION // reactions that are not upvotes or downvotes
  UPVOTE
  DOWNVOTE
  INTERACTION // interactive clicks, such as opening a review item modal
}

enum ReviewReactionType {
  LIKE     @map("💜")
  THANKFUL @map("🙏")
  SLAY     @map("💅")
  FUNNY    @map("🤣")
  CRYING   @map("😭")
  SHOCKED  @map("😦")
}

enum GradingBasis {
  PASS_FAIL @map("Pass/Fail")
  GRADED    @map("Graded")
  NA        @map("NA")
}

enum MultiplierType {
  EMPIRICAL   @map("empirical")
  THEORETICAL @map("theoretical")
}

enum PredictionType {
  MEDIAN @map("median")
  MIN    @map("min")
}

model ChatUsage {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  period            String // "YYYY-MM" in Asia/Singapore
  messageCount      Int      @default(0) @map("message_count")
  inputTokens       Int      @default(0) @map("input_tokens")
  outputTokens      Int      @default(0) @map("output_tokens")
  cachedInputTokens Int      @default(0) @map("cached_input_tokens")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Ephemeral usage rows follow the user id through Google id reconciles
  // (ON UPDATE CASCADE) and are removed with the user (ON DELETE CASCADE,
  // same as other user-owned ephemeral rows like RoadmapVote).
  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
  @@index([period])
  @@map("chat_usage")
}

model RateLimitWindow {
  key         String   @id
  windowStart BigInt   @map("window_start") // epoch ms of the fixed window
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("rate_limit")
}

// ==========================================
// GROUP MEETINGS & COORDINATION SUBSYSTEM
// ==========================================

model MeetingPoll {
  id                  String   @id @default(uuid())
  slug                String   @unique // 10-character nanoid for sharing (/meetings/[slug])
  title               String   @db.VarChar(120)
  description         String?  @db.VarChar(500)
  agenda              String?  @db.VarChar(2000) // What the meeting is for; editable by the creator
  links               String[] @default([])      // Up to MAX_MEETING_LINKS https URLs (call, docs, repo)

  // Creator relation (required, authenticated user)
  creatorId           String   @map("creator_id")
  creator             Users    @relation("MeetingPollCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  // Optional Academic Anchors (Course Backtracking)
  courseId            String?  @map("course_id")
  course              Courses? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  section             String?  @db.VarChar(10)     // e.g. "G1"
  teamIdentifier      String?  @map("team_identifier") @db.VarChar(50) // e.g. "Team 3", "G1-T2"
  acadTermId          String?  @map("acad_term_id")
  acadTerm            AcadTerm? @relation(fields: [acadTermId], references: [id], onDelete: SetNull)

  // Date and Time Range Boundaries (Strict ISO dates, no rolling offset)
  startDate           DateTime @map("start_date") @db.Date // Inclusive start date
  endDate             DateTime @map("end_date") @db.Date   // Inclusive end date
  startHour           Int      @default(8) @map("start_hour")   // 08:00 (24h)
  endHour             Int      @default(22) @map("end_hour")    // 22:00 (24h)
  slotDurationMinutes Int      @default(15) @map("slot_duration_minutes") // 15-minute standard slots

  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  participants        MeetingParticipant[]

  // High-Impact Indexes (ESR-Compliant):
  @@index([creatorId, createdAt(sort: Desc)]) // ESR: Equality on creator, Sort on createdAt
  @@index([courseId, acadTermId])            // Fast lookup of meetings by course & term
  @@index([acadTermId])                      // Fast filtering by semester
  @@map("meeting_polls")
}

model MeetingParticipant {
  id             String   @id @default(uuid())
  pollId         String   @map("poll_id")
  userId         String   @map("user_id") // Authenticated user

  // Availability arrays of 15-minute integer slot indices
  availableSlots Int[]    @default([]) @map("available_slots") // Green
  ifNeededSlots  Int[]    @default([]) @map("if_needed_slots") // Orange / Amber

  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  poll           MeetingPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user           Users       @relation(fields: [userId], references: [id], onDelete: Cascade)

  // High-Impact Indexes:
  @@unique([pollId, userId])                 // Atomic upsert constraint & 1 response per user
  @@index([userId, createdAt(sort: Desc)])   // Powers listMyMeetings dashboard query
  @@map("meeting_participants")
}

// ==========================================
// CONTENT MODERATION
// ==========================================

enum ModerationSurface {
  REVIEW
  ROADMAP
}

enum ModerationVerdict {
  VIOLATION
  CLEARED
  ERROR
}

/// One row per (reporter, item). Exactly one item relation is set — enforced
/// by the CHECK `moderation_reports_exactly_one_item` in the migration.
/// Adding a moderated surface = one more optional relation + unique + index here.
model ModerationReport {
  id         String   @id @default(uuid())
  reporterId String   @map("reporter_id")
  reviewId   String?  @map("review_id")
  roadmapId  String?  @map("roadmap_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  reporter Users        @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  review   Reviews?     @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  roadmap  UserRoadmap? @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@unique([reviewId, reporterId])
  @@unique([roadmapId, reporterId])
  @@index([reporterId])
  @@index([reviewId, createdAt])
  @@index([roadmapId, createdAt])
  @@map("moderation_reports")
}

/// Append-only audit of every judgement attempt. Deliberately NO relation to
/// the item: rows must outlive deleted reviews. Read in a SQL client.
/// removedText is set on VIOLATION rows only and is cleared after the
/// retention period by the moderation log prune cron.
model ModerationLog {
  id          String            @id @default(uuid())
  surface     ModerationSurface
  itemId      String            @map("item_id")
  verdict     ModerationVerdict
  policyRule  String?           @map("policy_rule") @db.VarChar(40)
  language    String?           @db.VarChar(20)
  rationale   String?           @db.VarChar(300)
  model       String            @db.VarChar(120)
  removedText String?           @map("removed_text")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([surface, itemId, verdict, createdAt(sort: Desc)])
  @@index([createdAt])
  @@map("moderation_logs")
}
